<Page x:Class="ToyShop.App.Views.MainComponents.MainAdminComponents.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToyShop.App.Views.MainComponents.MainAdminComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".1*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding Search}" Margin="5"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SelectedSort}" Margin="5" Width="150"/>
                <ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding SelectedFilter}" Margin="5" Width="150"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Width="75"/>
                <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" Width="75"/>
                <Button Content="Редактировать" Command="{Binding ManageCommand}" Margin="5" Width="75"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" Width="75"/>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{Binding Clients}">
            <ListView.View>
                <GridView >
                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding LastName}"/>
                    <GridViewColumn Header="Отчество" DisplayMemberBinding="{Binding MiddleName}"/>
                    <GridViewColumn Header="Эл. почта" DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding Number}"/>
                    <GridViewColumn Header="Дата рож." DisplayMemberBinding="{Binding DateOfBirth}"/>
                    <GridViewColumn Header="Дата рег." DisplayMemberBinding="{Binding DateOfRegistration}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
