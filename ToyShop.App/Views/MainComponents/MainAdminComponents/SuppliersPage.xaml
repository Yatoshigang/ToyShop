<Page x:Class="ToyShop.App.Views.MainComponents.MainAdminComponents.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToyShop.App.Views.MainComponents.MainAdminComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SuppliersPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".1*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding Search}" Margin="5"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Width="75"/>
                <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" Width="75"/>
                <Button Content="Редактировать" Command="{Binding ManageCommand}" Margin="5" Width="75"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" Width="75"/>
            </StackPanel>
        </Grid>

        <ListView HorizontalContentAlignment="Stretch" Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="Black" Margin="10">
                        <StackPanel Orientation="Vertical" Margin="5">
                            <TextBlock Text="{Binding Name_sup, TargetNullValue='null', StringFormat='Название: \{0\}'}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Country_sup, TargetNullValue='null', StringFormat='Страна: \{0\}'}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Number, TargetNullValue='null', StringFormat='Номер телефона: \{0\}'}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
