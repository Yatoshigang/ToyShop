<Page x:Class="ToyShop.App.Views.MainComponents.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToyShop.App.Views.MainComponents"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".1*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding Search}" Margin="5"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SelectedSort}" Margin="5" Width="150"/>
                <ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding SelectedFilter}" Margin="5" Width="150"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Width="75"/>
                <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" Width="75"/>
                <Button Content="Редактировать" Command="{Binding ManageCommand}" Margin="5" Width="75"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" Width="75"/>
            </StackPanel>
        </Grid>

        <ListView ItemsSource="{Binding SelectedProducts}" SelectedItem="{Binding SelectedProduct}" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseDoubleClick">
                    <b:InvokeCommandAction Command="{Binding DataContext.AddToCartByDoubleClickCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="2" Width="400" Height="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Resources/X.png" Grid.Column="0" Width="150" Height="150"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name_prod, StringFormat='Название: \{0\}'}"/>
                                <TextBlock Text="{Binding Brand.Name, StringFormat='Брэнд: \{0\}'}"/>
                                <TextBlock Text="{Binding Category.Name_cat, StringFormat='Категория: \{0\}'}"/>
                                <TextBlock Text="{Binding Supplier.Name_sup, StringFormat='Поставщик: \{0\}'}"/>
                                <TextBlock Text="{Binding Article, StringFormat='Артикль: \{0\}'}"/>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: \{0\}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
