<Page x:Class="ToyShop.App.Views.MainComponents.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToyShop.App.Views.MainComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">



    <ItemsControl ItemsSource="{Binding Cart}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Resources/Styles/Images/games.png" Grid.Column="0" Height="100" Width="100"/>

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBlock Text="{Binding Product.Name_prod, StringFormat='Название: \{0\}'}"/>
                        <TextBlock Text="{Binding Product.Brand.Name, StringFormat='Бренд: \{0\}'}"/>
                        <TextBlock Text="{Binding Product.Category.Name_cat, StringFormat='Категория: \{0\}'}"/>
                        <TextBlock Text="{Binding Product.Price, StringFormat='Цена: \{0\}'}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Button Content="-" Height="25" Width="25" Command="{Binding DataContext.DecreaseCountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Product.Name_prod}" Margin="5,0"/>
                        <TextBlock Text="{Binding Count, TargetNullValue='0'}" Height="25" Width="25" Margin="5,0"/>
                        <Button Content="+" Height="25" Width="25" Command="{Binding DataContext.IncreaseCountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Product.Name_prod}" Margin="5,0"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Купить" Command="{Binding DataContext.BuyProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Product.Name_prod}" Height="50"/>


                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Page>
