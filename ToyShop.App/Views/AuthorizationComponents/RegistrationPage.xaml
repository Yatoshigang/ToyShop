<Page x:Class="ToyShop.App.Views.AuthorizationComponents.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToyShop.App.Views.AuthorizationComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage" >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Width="200" Margin="0,10,0,0">
            <Label Content="Регистрация" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Label Content="Фамилия"/>
            <TextBox Text="{Binding LastName}" Margin="0,0,0,10"/>

            <Label Content="Имя"/>
            <TextBox Text="{Binding FirstName}" Margin="0,0,0,10"/>

            <Label Content="Отчество"/>
            <TextBox Text="{Binding Patronymic}" Margin="0,0,0,10"/>

            <Label Content="Электронная почта"/>
            <TextBox Text="{Binding Email}" Margin="0,0,0,10"/>

            <Label Content="Логин"/>
            <TextBox Text="{Binding Login}" Margin="0,0,0,10"/>

            <Label Content="Пароль"/>
            <TextBox Text="{Binding Password}" Margin="0,0,0,15"/>

            <Button Content="Зарегистрироваться" Command="{Binding SubmitRegistrationCommand}"/>
        </StackPanel>
    </Grid>
</Page>
