<Page x:Class="ToyShop.App.Views.AuthorizationComponents.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToyShop.App.Views.AuthorizationComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
            <Label Content="Вход" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0, 0, 0, 10"/>
            
            <Label Content="Логин"/>
            <TextBox Margin="0,0,0,10" Text="{Binding Login}"/>

            <Label Content="Пароль"/>
            <TextBox Margin="0,0,0,10" Text="{Binding Password}"/>

            <Button Content="Войти" Margin="10,5" Command="{Binding SubmitLoginCommand}"/>
        </StackPanel>
    </Grid>
</Page>
