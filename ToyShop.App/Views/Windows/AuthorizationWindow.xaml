<Window x:Class="ToyShop.App.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToyShop.App.Views"
        xmlns:comp="clr-namespace:ToyShop.App.Views.AuthorizationComponents"
        mc:Ignorable="d"
        Title="Авторизация" Background="{StaticResource BackgroundAuthBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Frame Grid.Column="0" Content="{Binding FrameContent}" NavigationUIVisibility="Hidden"/>
            <Image Grid.Column="1" Source="/Resources/Styles/Images/bears.png" />
        </Grid>
        <Button Grid.Row="1" HorizontalAlignment="Left" Content="{Binding ButtonTitle}" Command="{Binding ChangePageCommand}" Margin="5,0,0,5" Width="125" Height="25"/>
    </Grid>
</Window>
