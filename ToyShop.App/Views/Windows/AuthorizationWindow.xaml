<Window x:Class="ToyShop.App.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToyShop.App.Views"
        xmlns:comp="clr-namespace:ToyShop.App.Views.AuthorizationComponents"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height=".05*"/>
        </Grid.RowDefinitions>
        <Frame Content="{Binding FrameContent}" NavigationUIVisibility="Hidden" Grid.Row="0"/>
        <Button Grid.Row="1" HorizontalAlignment="Left" Content="{Binding ButtonTitle}" Command="{Binding ChangePage}"/>
    </Grid>
</Window>
