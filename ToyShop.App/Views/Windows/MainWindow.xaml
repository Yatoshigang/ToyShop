<Window x:Class="ToyShop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToyShop.App.Views"
        mc:Ignorable="d"
        MinHeight="500" MinWidth="800" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".15*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width=".2*"/>
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Pages}" Grid.Column="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Key}" Command="{Binding DataContext.GoToComponentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}" VerticalAlignment="Center" Margin="2" Height="50" Width="100"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            <Button Grid.Column="1" Content="Выход" Command="{Binding LogOutCommand}" VerticalAlignment="Center" Margin="10" Height="50" Width="150"/>
        </Grid>
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="10">
            <Frame Content="{Binding FrameContent}" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
